{
  "name": "agent-pantry-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Human-reviewed Agent Skills you can inspect, install, and adapt.",
  "license": "MIT",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @agent-pantry/web dev",
    "typecheck": "pnpm --filter @agent-pantry/web typecheck && pnpm --filter agent-pantry typecheck",
    "test": "pnpm --filter agent-pantry test",
    "validate": "node scripts/validate-skills.mjs",
    "eval:review": "node scripts/generate-eval-review.mjs",
    "repo:configure": "node scripts/configure-repository.mjs",
    "check": "pnpm validate && pnpm typecheck && pnpm test"
  }
}
